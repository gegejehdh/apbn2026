                <div id="palette-grid" class="grid grid-cols-10 sm:grid-cols-20 gap-1.5 max-h-36 overflow-y-auto p-1">
                    <!-- Palette numbers -->
                </div>
            </div>
        </div>

        <!-- Result & Evaluation View -->
        <div id="result-view" class="hidden space-y-6">
            <div class="bg-slate-800 border border-slate-700 rounded-2xl p-6 sm:p-10 shadow-2xl text-center space-y-6">
