                        <span id="score-display" class="text-4xl font-extrabold text-amber-400">0</span>
                        <span class="text-xs text-slate-500">skor maksimal 100</span>
                    </div>
                </div>

                <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 max-w-2xl mx-auto text-sm">
                    <div class="bg-slate-900/60 p-3 rounded-xl border border-slate-700">
                        <span class="block text-emerald-400 font-bold text-lg" id="stat-correct">0</span>
                        <span class="text-slate-400">Jawaban Benar</span>
                    </div>
                    <div class="bg-slate-900/60 p-3 rounded-xl border border-slate-700">
                        <span class="block text-rose-400 font-bold text-lg" id="stat-wrong">0</span>
                        <span class="text-slate-400">Jawaban Salah</span>
                    </div>
