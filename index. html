        let userAnswers = new Array(questionsDatabase.length).fill(null);
        let timeLeft = 90 * 60; // 1 hours 30 minutes in seconds
        let timerInterval = null;
        let isReviewMode = false;

        // DOM Elements
        const welcomeView = document.getElementById('welcome-view');
        const quizView = document.getElementById('quiz-view');
        const resultView = document.getElementById('result-view');
        const timerBox = document.getElementById('timer-box');
        const timerEl = document.getElementById('timer');
        const currentQNum = document.getElementById('current-q-num');
        const totalQNum = document.getElementById('total-q-num');
        const progressBar = document.getElementById('progress-bar');
        const unansweredCount = document.getElementById('unanswered-count');
        const questionBadge = document.getElementById('question-badge');
        const questionId = document.getElementById('question-id');
        const questionText = document.getElementById('question-text');
        const optionsContainer = document.getElementById('options-container');
        const prevBtn = document.getElementById('prev-btn');
        const nextBtn = document.getElementById('next-btn');
        const submitBtn = document.getElementById('submit-btn');
        const paletteGrid = document.getElementById('palette-grid');
        const confirmModal = document.getElementById('confirm-modal');

        totalQNum.textContent = questionsDatabase.length;

        function startQuiz() {
            welcomeView.classList.add('hidden');
            quizView.classList.remove('hidden');
            timerBox.classList.remove('hidden');
            timerBox.classList.add('flex');
            
            buildPalette();
            loadQuestion(0);
            startTimer();
        }

        function startTimer() {
            timerInterval = setInterval(() => {
                if (timeLeft <= 0) {
                    clearInterval(timerInterval);
                    alert("Waktu pengerjaan 1 jam 30 menit telah habis!");
                    submitQuiz();
                    return;
                }
                timeLeft--;
                let hours = Math.floor(timeLeft / 3600);
                let minutes = Math.floor((timeLeft % 3600) / 60);
                let seconds = timeLeft % 60;
                timerEl.textContent = `${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
            }, 1000);
        }

        function buildPalette() {
            paletteGrid.innerHTML = '';
            for (let i = 0; i < questionsDatabase.length; i++) {
                const btn = document.createElement('button');
                btn.textContent = i + 1;
                btn.className = `w-7 h-7 rounded-lg text-xs font-bold transition flex items-center justify-center border ${
                    userAnswers[i] !== null 
                        ? 'bg-blue-600 border-blue-500 text-white' 
                        : 'bg-slate-700 border-slate-600 text-slate-300 hover:bg-slate-600'
                }`;
                btn.onclick = () => loadQuestion(i);
                btn.id = `palette-btn-${i}`;
                paletteGrid.appendChild(btn);
            }
        }

        function updatePalette() {
            for (let i = 0; i < questionsDatabase.length; i++) {
                const btn = document.getElementById(`palette-btn-${i}`);
                if (!btn) continue;
                if (i === currentQuestionIndex) {
                    btn.className = `w-7 h-7 rounded-lg text-xs font-extrabold flex items-center justify-center border ring-2 ring-amber-400 ${
                        userAnswers[i] !== null ? 'bg-blue-600 border-white text-white' : 'bg-amber-500 border-amber-400 text-slate-950'
                    }`;
                } else {
                    btn.className = `w-7 h-7 rounded-lg text-xs font-bold transition flex items-center justify-center border ${
                        userAnswers[i] !== null 
                            ? 'bg-blue-600 border-blue-500 text-white' 
                            : 'bg-slate-700 border-slate-600 text-slate-300 hover:bg-slate-600'
                    }`;
                }
            }
        }

        function loadQuestion(index) {
            currentQuestionIndex = index;
            const q = questionsDatabase[index];

            currentQNum.textContent = index + 1;
            questionId.textContent = `No. ${index + 1}`;
            questionText.textContent = q.q;

            // Update Progress & Unanswered
            const answeredCount = userAnswers.filter(a => a !== null).length;
            unansweredCount.textContent = questionsDatabase.length - answeredCount;
            progressBar.style.width = `${((index + 1) / questionsDatabase.length) * 100}%`;

            // Render Options
            optionsContainer.innerHTML = '';
            q.options.forEach((opt, optIdx) => {
                const isSelected = userAnswers[index] === optIdx;
                const optDiv = document.createElement('div');
                optDiv.className = `p-4 rounded-xl border cursor-pointer transition flex items-center space-x-3 ${
                    isSelected 
                        ? 'bg-blue-600/30 border-blue-500 text-white font-medium shadow' 
                        : 'bg-slate-900/50 border-slate-700 text-slate-300 hover:bg-slate-700/50 hover:border-slate-600'
                }`;
                optDiv.onclick = () => selectOption(optIdx);
                
                optDiv.innerHTML = `
                    <div class="w-6 h-6 rounded-full border flex items-center justify-center text-xs font-bold ${
                        isSelected ? 'bg-blue-500 border-blue-400 text-white' : 'border-slate-600 text-slate-400'
                    }">${String.fromCharCode(65 + optIdx)}</div>
                    <div class="flex-grow text-sm sm:text-base">${opt.substring(3)}</div>
                `;
                optionsContainer.appendChild(optDiv);
            });

            // Buttons state
            prevBtn.disabled = index === 0;
            if (index === questionsDatabase.length - 1) {
                nextBtn.classList.add('hidden');
                submitBtn.classList.remove('hidden');
            } else {
                nextBtn.classList.remove('hidden');
                submitBtn.classList.add('hidden');
            }

            updatePalette();
        }

        function selectOption(optIdx) {
            userAnswers[currentQuestionIndex] = optIdx;
            loadQuestion(currentQuestionIndex);
        }

        function nextQuestion() {
            if (currentQuestionIndex < questionsDatabase.length - 1) {
                loadQuestion(currentQuestionIndex + 1);
            }
        }

        function prevQuestion() {
            if (currentQuestionIndex > 0) {
                loadQuestion(currentQuestionIndex - 1);
            }
        }

        function confirmSubmit() {
            const unanswered = userAnswers.filter(a => a === null).length;
            if (unanswered > 0) {
                confirmModal.classList.remove('hidden');
            } else {
                submitQuiz();
            }
        }

        function closeModal() {
            confirmModal.classList.add('hidden');
        }

        function submitQuiz() {
            closeModal();
            clearInterval(timerInterval);
            timerBox.classList.add('hidden');
            quizView.classList.add('hidden');
            resultView.classList.remove('hidden');

            // Calculate score & statistics
            let correctCount = 0;
            let wrongCount = 0;
            let unansweredCountVal = 0;

            userAnswers.forEach((ans, idx) => {
                if (ans === null) {
                    unansweredCountVal++;
                } else if (ans === questionsDatabase[idx].correct) {
                    correctCount++;
                } else {
                    wrongCount++;
                }
            });

            const finalScore = Math.round((correctCount / questionsDatabase.length) * 100);
            document.getElementById('score-display').textContent = finalScore;
            document.getElementById('stat-correct').textContent = correctCount;
            document.getElementById('stat-wrong').textContent = wrongCount;
            document.getElementById('stat-unanswered').textContent = unansweredCountVal;
            document.getElementById('stat-accuracy').textContent = `${Math.round((correctCount / (correctCount + wrongCount || 1)) * 100)}%`;

            buildReviewList();
        }

        function toggleReviewMode() {
            const container = document.getElementById('review-container');
            container.classList.toggle('hidden');
            container.scrollIntoView({ behavior: 'smooth' });
        }

        function buildReviewList() {
            const reviewList = document.getElementById('review-list');
            reviewList.innerHTML = '';

            questionsDatabase.forEach((q, idx) => {
                const userAns = userAnswers[idx];
                const isCorrect = userAns === q.correct;
                const isUnanswered = userAns === null;

                const card = document.createElement('div');
                card.className = `p-5 rounded-xl border ${
                    isCorrect ? 'bg-slate-800/90 border-emerald-500/40' : 'bg-slate-800/90 border-rose-500/40'
                } space-y-3`;

                let optionsHtml = '';
                q.options.forEach((opt, oIdx) => {
                    let badge = '';
                    let colorClass = 'text-slate-300';
                    if (oIdx === q.correct) {
                        badge = ' <span class="bg-emerald-500/20 text-emerald-400 text-xs px-2 py-0.5 rounded font-bold">Kunci Benar</span>';
                        colorClass = 'text-emerald-300 font-semibold';
                    } else if (oIdx === userAns && !isCorrect) {
                        badge = ' <span class="bg-rose-500/20 text-rose-400 text-xs px-2 py-0.5 rounded font-bold">Jawaban Anda</span>';
                        colorClass = 'text-rose-300 font-semibold';
                    }
                    optionsHtml += `<div class="text-sm ${colorClass} py-1">${opt}${badge}</div>`;
                });

                card.innerHTML = `
                    <div class="flex justify-between items-center">
                        <span class="text-xs font-mono text-slate-400">Soal Nomor ${idx + 1}</span>
                        <span class="text-xs px-2.5 py-1 rounded-full font-bold ${
                            isUnanswered ? 'bg-amber-500/20 text-amber-400' : isCorrect ? 'bg-emerald-500/20 text-emerald-400' : 'bg-rose-500/20 text-rose-400'
                        }">${isUnanswered ? 'Tidak Dijawab' : isCorrect ? 'Benar ✓' : 'Salah ✕'}</span>
                    </div>
                    <h4 class="text-base font-semibold text-white">${q.q}</h4>
                    <div class="space-y-1 bg-slate-900/60 p-3 rounded-lg border border-slate-700">
                        ${optionsHtml}
                    </div>
                    <div class="bg-blue-950/40 border border-blue-900/50 p-3 rounded-lg text-xs sm:text-sm text-blue-200">
                        <strong class="text-amber-400">Pembahasan / Evaluasi Modul:</strong> ${q.explanation}
                    </div>
                `;
                reviewList.appendChild(card);
            });
        }
    </script>
</body>
</html>

