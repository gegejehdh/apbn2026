                </div>
                
                <h3 id="question-text" class="text-base sm:text-lg font-semibold text-white leading-relaxed">
                    Pertanyaan soal akan dimuat di sini...
                </h3>

                <!-- Options List (A - E) -->
                <div id="options-container" class="space-y-3">
                    <!-- Dynamic Options -->
                </div>
            </div>

            <!-- Navigation Buttons -->
            <div class="flex justify-between items-center pt-2">
                <button onclick="prevQuestion()" id="prev-btn" class="bg-slate-700 hover:bg-slate-600 text-white font-semibold px-5 py-2.5 rounded-xl transition disabled:opacity-40 disabled:cursor-not-allowed">
                    ← Sebelumnya
                </button>
                <div class="flex space-x-3">
                    <button onclick="nextQuestion()" id="next-btn" class="bg-blue-600 hover:bg-blue-500 text-white font-semibold px-6 py-2.5 rounded-xl transition">
                        Selanjutnya →
                    </button>
                    <button onclick="confirmSubmit()" id="submit-btn" class="hidden bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold px-6 py-2.5 rounded-xl transition shadow-lg">
                        Selesaikan Kuis 🎯
                    </button>
                </div>
            </div>

