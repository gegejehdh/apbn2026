            </p>
            <div class="flex space-x-3 pt-2">
                <button onclick="closeModal()" class="flex-1 bg-slate-700 hover:bg-slate-600 text-white font-semibold py-2.5 rounded-xl transition">
                    Lanjut Periksa
                </button>
                <button onclick="submitQuiz()" class="flex-1 bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-2.5 rounded-xl transition">
                    Ya, Selesaikan
                </button>
            </div>
        </div>
    </div>

    <!-- Footer -->
