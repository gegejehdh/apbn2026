            </button>
        </div>

        <!-- Quiz View -->
        <div id="quiz-view" class="hidden space-y-6">
            <!-- Progress & Navigator Bar -->
            <div class="bg-slate-800 border border-slate-700 rounded-xl p-4 flex flex-wrap justify-between items-center gap-4">
                <div class="text-sm font-semibold text-slate-300">
                    Soal <span id="current-q-num" class="text-amber-400 font-bold text-base">1</span> dari <span id="total-q-num">100</span>
                </div>
                <div class="w-full sm:w-64 bg-slate-700 h-2.5 rounded-full overflow-hidden">
                    <div id="progress-bar" class="bg-amber-500 h-full w-0 transition-all duration-300"></div>
                </div>
                <div class="text-xs text-slate-400 font-medium">
                    Belum dijawab: <span id="unanswered-count" class="text-amber-400 font-bold">100</span>
                </div>
            </div>

